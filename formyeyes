/**
 * @file    arducam.h
 * @brief   ArduCAM OV2640 driver for STM32 L4R5ZI-P
 *          
 *
 *  Wiring on L4R5ZI-P:
 *    ArduCAM CS  → GPIOD PIN_14
 *    ArduCAM SPI → hspi2  (SCK/MOSI/MISO)
 *    OV2640 I2C  → hi2c2  (SDA/SCL)
 *
 *  NOTE: hspi1 is reserved for the ST7796 display.
 *        hspi2 is dedicated to the ArduCAM.
 */

#ifndef ARDUCAM_H
#define ARDUCAM_H

#include "main.h"
#include <stdint.h>

/* ─── Hardware config ────────────────────────────────────────────────────── */
#define ARDUCAM_CS_PORT         GPIOD
#define ARDUCAM_CS_PIN          GPIO_PIN_14

/* SPI handle for ArduCAM chip registers and FIFO */
extern SPI_HandleTypeDef  hspi2;

/* I2C handle for OV2640 sensor registers */
extern I2C_HandleTypeDef  hi2c2;

/* OV2640 I2C address (7-bit 0x30, shifted for HAL) */
#define OV2640_I2C_ADDR         (0x30 << 1)

/* ─── ArduCAM chip register addresses ───────────────────────────────────── */
#define ARDUCHIP_TEST1          0x00
#define ARDUCHIP_MODE           0x03   /* 0x00=JPEG, 0x02=RAW */
#define ARDUCHIP_FIFO           0x04
#define ARDUCHIP_TRIG           0x41
#define BURST_FIFO_READ         0x3C

/* FIFO control values */
#define FIFO_FLUSH              0x01
#define FIFO_START              0x02

/* Capture done flag */
#define CAP_DONE_MASK           0x08

/* ─── Sensor register struct ──────────── */
struct sensor_reg {
    uint8_t reg;
    uint8_t val;
};

/* ─── Public API ─────────────────────────────────────────────────────────── */

/**
 * @brief  Write to an ArduCAM SPI chip register.
 *         CS managed internally.
 */
void arducam_spi_write(uint8_t address, uint8_t value);

/**
 * @brief  Read from an ArduCAM SPI chip register.
 *         CS managed internally.
 */
uint8_t arducam_spi_read(uint8_t address);

/**
 * @brief  Write one register to the OV2640 sensor over I2C.
 */
void wrSensorReg8_8(uint8_t reg, uint8_t data);

/**
 * @brief  Write a register table to the OV2640 sensor.
 *         Table must be terminated with {0xFF, 0xFF}.
 */
void wrSensorRegs8_8(const struct sensor_reg reglist[]);

/**
 * @brief  Initialise the OV2640 for RAW QVGA (320x240 RGB565) mode.
 *         Call once after SPI and I2C peripherals are ready.
 */
void OV2640_RAW_Init(void);

/**
 * @brief  Capture one RAW QVGA frame into the ArduCAM FIFO,
 *         then stream it directly to the ST7796 display.
 *         The display window must be set by the caller before calling this.
 *
 * @return 0 on success, 1 on capture timeout.
 */
uint8_t Arducam_CaptureToDisplay(void);

#endif /* ARDUCAM_H */
