/* ─── Camera capture + display ─────────────────────────────────────────── */
static void UI_CaptureAndShow(void)
{
    /* ── 1. Clear screen and draw header ── */
    ST7796_FillScreen(ST7796_BLACK);
    ST7796_DrawString(10, 8, "TAP SCREEN OR PRESS BUTTON TO EXIT",
                      ST7796_WHITE, ST7796_BLACK, 1);
    ST7796_DrawHLine(0, 22, ST7796_WIDTH, ST7796_DARKGREY);
 
    /* Show "capturing" message while we wait */
    ST7796_DrawString(160, 160, "CAPTURING...", ST7796_YELLOW, ST7796_BLACK, 2);
 
    /* ── 2. Set display window for the image ── */
    /*
     * Display is landscape 480x320.
     * Image is QVGA 320x240.
     * Centre it: x offset = (480-320)/2 = 80, y offset = 28 (below header)
     */
    uint16_t img_x = (ST7796_WIDTH  - 320U) / 2U;  /* 80 */
    uint16_t img_y = 28U;
 
    /* Open the address window on the ST7796 */
    ST7796_WriteCmd(0x2A);  /* CASET */
    ST7796_WriteData8((uint8_t)(img_x >> 8));
    ST7796_WriteData8((uint8_t)(img_x & 0xFF));
    uint16_t x1 = img_x + 320U - 1U;
    ST7796_WriteData8((uint8_t)(x1 >> 8));
    ST7796_WriteData8((uint8_t)(x1 & 0xFF));
 
    ST7796_WriteCmd(0x2B);  /* RASET */
    ST7796_WriteData8((uint8_t)(img_y >> 8));
    ST7796_WriteData8((uint8_t)(img_y & 0xFF));
    uint16_t y1 = img_y + 240U - 1U;
    ST7796_WriteData8((uint8_t)(y1 >> 8));
    ST7796_WriteData8((uint8_t)(y1 & 0xFF));
 
    ST7796_WriteCmd(0x2C);  /* RAMWR — keep pixel stream open */
 
    /* Clear the "capturing" text area before pixels arrive */
    /* (the window is already open so we can't fill here — just proceed) */
 
    /* ── 3. Capture and stream directly to display ── */
    uint8_t result = Arducam_CaptureToDisplay();
 
    if (result != 0)
    {
        /* Capture failed — show error */
        ST7796_FillScreen(ST7796_BLACK);
        ST7796_DrawString(100, 150, "CAPTURE FAILED", ST7796_RED, ST7796_BLACK, 2);
        ST7796_DrawString(80, 180, "TAP TO RETURN", ST7796_WHITE, ST7796_BLACK, 1);
    }
}
 
/* ─── Wait for any input, then redraw the dashboard ────────────────────── */
static void UI_WaitForExitThenDashboard(
        int     screenTemp,
        int     humidity,
        uint8_t lightOn,
        uint8_t baskingOccupied,
        uint8_t tempShowCurrent,
        uint8_t humShowCurrent)
{
    uint8_t exit_view = 0;
 
    /* Drain any stale touch event from the capture tap */
    HAL_Delay(300);
 
    while (!exit_view)
    {
        /* Touch anywhere exits */
        uint16_t tx, ty;
        if (Touch_GetPoint(&tx, &ty))
        {
            exit_view = 1;
        }
 
        /* Any BT remote button exits (consume without acting on it) */
        if (bt_rx_ready)
        {
            bt_rx_ready = 0;
            exit_view   = 1;
        }
 
        HAL_Delay(15);
    }
 
    /* Repaint the full dashboard */
    UI_DrawAll(screenTemp, humidity, lightOn, baskingOccupied);
}
