while (1)
{
    for (int i = 0; i < 6; i++)
    {
        RemoteButton_t *btn = &s_buttons[i];

        if (HAL_GPIO_ReadPin(btn->port, btn->pin) == GPIO_PIN_RESET) /* pressed */
        {
            if (btn->debounce_count < DEBOUNCE_TICKS)
            {
                btn->debounce_count++;
            }

            if (btn->debounce_count >= DEBOUNCE_TICKS && !btn->last_sent)
            {
                HAL_UART_Transmit(&huart2, &btn->command, 1, 100);
                btn->last_sent = 1;
            }
        }
        else /* released */
        {
            btn->debounce_count = 0;
            btn->last_sent      = 0;
        }
    }

    HAL_Delay(10); /* 10ms per tick — 3 ticks = 30ms debounce */
}



extern UART_HandleTypeDef huart2;

typedef struct {
    GPIO_TypeDef *port;
    uint16_t      pin;
    uint8_t       command;
    uint8_t       debounce_count;
    uint8_t       last_sent;
} RemoteButton_t;

static RemoteButton_t s_buttons[6] = {
    { GPIOB, GPIO_PIN_4,  BT_CMD_TEMP_UP,   0, 0 },  /* PB4  - Heat Up    */
    { GPIOB, GPIO_PIN_5,  BT_CMD_TEMP_DOWN, 0, 0 },  /* PB5  - Heat Down  */
    { GPIOA, GPIO_PIN_8,  BT_CMD_HUM_UP,    0, 0 },  /* PA8  - Humid Up   */
    { GPIOA, GPIO_PIN_11, BT_CMD_HUM_DOWN,  0, 0 },  /* PA11 - Humid Down */
    { GPIOA, GPIO_PIN_12, BT_CMD_CAMERA,    0, 0 },  /* PA12 - Camera     */
    { GPIOB, GPIO_PIN_0,  BT_CMD_LIGHT,     0, 0 },  /* PB0  - Light      */
};



#define BT_CMD_TEMP_UP    'A'
#define BT_CMD_TEMP_DOWN  'B'
#define BT_CMD_HUM_UP     'C'
#define BT_CMD_HUM_DOWN   'D'
#define BT_CMD_CAMERA     'E'
#define BT_CMD_LIGHT      'F'

#define DEBOUNCE_TICKS    3U
